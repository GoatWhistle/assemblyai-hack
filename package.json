{
  "name": "readback",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "biome check src app tests scripts",
    "format": "biome check --write src app tests scripts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --no-file-parallelism",
    "test:watch": "vitest",
    "test:cover": "vitest run --coverage --no-file-parallelism",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@vercel/blob": "1.1.1",
    "next": "15.5.25",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.4",
    "@playwright/test": "1.55.0",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "22.18.1",
    "@types/react": "19.1.13",
    "@types/react-dom": "19.1.9",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "5.0.2",
    "@vitest/coverage-v8": "3.2.4",
    "jsdom": "26.1.0",
    "tsx": "4.20.5",
    "typescript": "5.9.2",
    "vitest": "3.2.4",
    "ws": "^8.21.3"
  }
}
